#!/bin/sh
# pre-commit 钩子：提交前运行 lint 检查（package.json 的 precommit 脚本）
# 通过 package.json 的 prepare 脚本（setup-git-hooks.mjs）注册 core.hooksPath=.githooks
[ "$SKIP_GIT_HOOKS" = "1" ] && exit 0
if ! npm run precommit; then
  echo "pre-commit: 检查未通过。如确需跳过，使用 git commit --no-verify 或 SKIP_GIT_HOOKS=1" >&2
  exit 1
fi
